@model List<EduTrack.Models.Student>
@{
    ViewData["Title"] = "الطلاب";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">قائمة الطلاب</h2>
        <span class="badge bg-primary fs-6">@Model.Count طالب</span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">لا يوجد طلاب مسجلون بعد.</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>الاسم</th>
                                <th>رقم الهاتف</th>
                                <th>الجامعة / الكلية</th>
                                <th>الكورس</th>
                                <th>عدد التسليمات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int rowNum = 1;}
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>@rowNum</td>
                                    <td class="fw-semibold">@student.FullName</td>
                                    <td>@student.PhoneNumber</td>
                                    <td>@(student.University ?? "-")</td>
                                    <td>
                                        @if (student.Course != null)
                                        {
                                            <a asp-controller="Courses" asp-action="Details"
                                               asp-route-id="@student.Course.Id"
                                               class="text-decoration-none">
                                                @student.Course.Title
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@student.Submissions.Count</span>
                                    </td>
                                </tr>
                                rowNum++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
