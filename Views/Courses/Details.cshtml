@model EduTrack.Models.Course
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="container py-4">
    <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4">
        ← العودة لقائمة الكورسات
    </a>

    <div class="row mb-4">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
            {
                <img src="~/images/courses/@Model.ThumbnailPath"
                     alt="@Model.Title"
                     class="img-fluid rounded shadow"
                     style="max-height:250px;width:100%;object-fit:cover;" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center shadow"
                     style="height:250px;font-size:4rem;">
                    📚
                </div>
            }
        </div>
        <div class="col-md-8">
            <h2 class="fw-bold">@Model.Title</h2>
            <p class="text-muted">@Model.Description</p>
            <div class="d-flex flex-wrap gap-3 mt-3">
                <span class="badge bg-secondary fs-6">⏱ @Model.TotalHours ساعة</span>
                <span class="badge bg-primary fs-6">👥 @Model.Students.Count طالب</span>
                <span class="badge bg-success fs-6">📋 @Model.Assignments.Count تاسك</span>
            </div>
            @if (Model.Instructor != null)
            {
                <div class="mt-3">
                    <strong>المحاضر:</strong>
                    <a asp-controller="Instructor" asp-action="Details" asp-route-id="@Model.Instructor.Id"
                       class="ms-1 text-decoration-none">
                        @Model.Instructor.FullName
                    </a>
                </div>
            }
            @if (User.IsInRole("Admin"))
            {
                <div class="mt-3">
                    <a asp-controller="Courses" asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-warning btn-sm">
                        تعديل الكورس
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- التاسكات -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span class="fw-bold">التاسكات (Assignments)</span>
            @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
            {
                <a asp-controller="Assignments" asp-action="Create" asp-route-courseId="@Model.Id"
                   class="btn btn-light btn-sm">
                    + إضافة تاسك
                </a>
            }
        </div>
        <div class="card-body">
            @if (!Model.Assignments.Any())
            {
                <p class="text-muted mb-0">لا توجد تاسكات بعد في هذا الكورس.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>العنوان</th>
                                <th>آخر موعد تسليم</th>
                                <th>الدرجة العظمى</th>
                                <th>عدد التسليمات</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments)
                            {
                                <tr>
                                    <td class="fw-semibold">@assignment.Title</td>
                                    <td>
                                        <span class="@(assignment.Deadline < DateTime.Now ? "text-danger" : "text-success")">
                                            @assignment.Deadline.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td>@assignment.MaxDegree</td>
                                    <td>
                                        <span class="badge bg-secondary">@assignment.Submissions.Count</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Assignments" asp-action="Details" asp-route-id="@assignment.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            عرض
                                        </a>
                                        @if (User.IsInRole("Student"))
                                        {
                                            <a asp-controller="Submissions" asp-action="Submit"
                                               asp-route-assignmentId="@assignment.Id"
                                               class="btn btn-success btn-sm ms-1">
                                                تسليم
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- الطلاب -->
    @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white fw-bold">
                الطلاب المسجلون (@Model.Students.Count)
            </div>
            <div class="card-body">
                @if (!Model.Students.Any())
                {
                    <p class="text-muted mb-0">لا يوجد طلاب مسجلون بعد في هذا الكورس.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var student in Model.Students)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@student.FullName</span>
                                <span class="text-muted small">@student.PhoneNumber</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>
