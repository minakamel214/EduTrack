@model List<EduTrack.Models.Course>
@{
    ViewData["Title"] = "الكورسات";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">الكورسات التدريبية</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Courses" asp-action="Create" class="btn btn-primary">
                + إضافة كورس جديد
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">لا توجد كورسات متاحة حالياً.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                        {
                            <img src="~/images/courses/@course.ThumbnailPath"
                                 alt="@course.Title"
                                 class="card-img-top"
                                 style="height:180px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height:180px;font-size:3rem;">
                                📚
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@course.Title</h5>
                            <p class="card-text text-muted small">
                                @(course.Description.Length > 100
                                    ? course.Description.Substring(0, 100) + "..."
                                    : course.Description)
                            </p>
                            <div class="d-flex gap-2 flex-wrap mt-2">
                                <span class="badge bg-secondary">⏱ @course.TotalHours ساعة</span>
                                <span class="badge bg-primary">👥 @course.Students.Count طالب</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id"
                               class="btn btn-outline-primary btn-sm flex-fill">
                                عرض التفاصيل
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id"
                                   class="btn btn-outline-warning btn-sm">
                                    تعديل
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
