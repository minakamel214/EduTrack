@model EduTrack.Models.Course
@{
    ViewData["Title"] = "تعديل الكورس";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="card-title fw-bold text-warning mb-4">تعديل بيانات الكورس</h2>

                    <form method="post"
                          asp-controller="Courses"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TotalHours" class="form-label fw-semibold"></label>
                            <input asp-for="TotalHours" type="number" class="form-control" min="1" max="500" />
                            <span asp-validation-for="TotalHours" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InstructorId" class="form-label fw-semibold">المحاضر</label>
                            <select asp-for="InstructorId" class="form-select">
                                <option value="">-- اختر المحاضر --</option>
                                @if (ViewBag.Instructors != null)
                                {
                                    foreach (var instructor in (List<EduTrack.Models.Instructor>)ViewBag.Instructors)
                                    {
                                        <option value="@instructor.Id"
                                                selected="@(instructor.Id == Model.InstructorId ? "selected" : null)">
                                            @instructor.FullName
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
                            {
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">الصورة الحالية</label>
                                    <div>
                                        <img src="~/images/courses/@Model.ThumbnailPath"
                                             alt="صورة الكورس"
                                             class="rounded"
                                             style="max-width:200px;max-height:120px;object-fit:cover;" />
                                    </div>
                                </div>
                            }
                            <label for="ThumbnailFile" class="form-label fw-semibold">
                                @(string.IsNullOrEmpty(Model.ThumbnailPath) ? "صورة الغلاف (اختياري)" : "تغيير صورة الغلاف")
                            </label>
                            <input type="file" id="ThumbnailFile" name="ThumbnailFile"
                                   class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning px-4">حفظ التعديلات</button>
                            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
