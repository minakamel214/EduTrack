@{
    ViewData["Title"] = "الرئيسية";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">مرحباً بك في EduTrack</h1>
        <p class="lead text-muted">منصة إدارة الكورسات التدريبية والتاسكات والتسليمات</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-book-half"></i> 📚
                    </div>
                    <h2 class="fw-bold text-primary">@ViewBag.CoursesCount</h2>
                    <p class="text-muted mb-0">كورس تدريبي</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-4">
                    <div class="display-5 text-success mb-2">🎓</div>
                    <h2 class="fw-bold text-success">@ViewBag.InstructorsCount</h2>
                    <p class="text-muted mb-0">محاضر</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-4">
                    <div class="display-5 text-warning mb-2">👨‍🎓</div>
                    <h2 class="fw-bold text-warning">@ViewBag.StudentsCount</h2>
                    <p class="text-muted mb-0">طالب</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm h-100">
                <div class="card-body py-4">
                    <div class="display-5 text-danger mb-2">📝</div>
                    <h2 class="fw-bold text-danger">@ViewBag.SubmissionsCount</h2>
                    <p class="text-muted mb-0">تسليم</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg me-2">
            استعراض الكورسات
        </a>
        @if (!User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg">
                تسجيل الدخول
            </a>
        }
    </div>
</div>
