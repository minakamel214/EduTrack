@model EduTrack.Models.Instructor
@{
    ViewData["Title"] = "تفاصيل المحاضر";
    Layout = "_Layout";
}

<div class="container py-4">
    <a asp-controller="Instructor" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4">
        ← العودة لقائمة المحاضرين
    </a>

    <div class="row">
        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="~/images/instructors/@Model.ImagePath"
                     alt="@Model.FullName"
                     class="rounded-circle shadow mb-3"
                     style="width:150px;height:150px;object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center shadow mb-3"
                     style="width:150px;height:150px;font-size:3.5rem;color:white;">
                    👤
                </div>
            }
            <h3 class="fw-bold">@Model.FullName</h3>
            <p class="text-primary fw-semibold">@Model.Specialization</p>
            <p class="text-muted">@Model.Email</p>
        </div>

        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">نبذة عن المحاضر</h5>
                        <p class="text-muted mb-0">@Model.Bio</p>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">
                    الكورسات (@Model.Courses.Count)
                </div>
                <div class="card-body">
                    @if (!Model.Courses.Any())
                    {
                        <p class="text-muted mb-0">لا توجد كورسات مرتبطة بهذا المحاضر بعد.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var course in Model.Courses)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@course.Title</span>
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id"
                                       class="btn btn-outline-primary btn-sm">عرض</a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
