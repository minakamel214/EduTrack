@{
    ViewData["Title"] = "تسليم الحل";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="card-title fw-bold text-success mb-1">تسليم الحل</h2>
                    @if (ViewBag.AssignmentTitle != null)
                    {
                        <p class="text-muted mb-4">التاسك: <strong>@ViewBag.AssignmentTitle</strong></p>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <form method="post"
                          asp-controller="Submissions"
                          asp-action="Submit"
                          asp-route-assignmentId="@ViewBag.AssignmentId"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="solutionFile" class="form-label fw-semibold">ملف الحل <span class="text-danger">*</span></label>
                            <input type="file" id="solutionFile" name="solutionFile"
                                   class="form-control" accept=".zip,.rar,.pdf" required />
                            <div class="form-text text-muted">
                                الصيغ المقبولة: ZIP، RAR، PDF — الحجم الأقصى: 50 MB
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">📤 إرسال الحل</button>
                            @if (ViewBag.AssignmentId != null)
                            {
                                <a asp-controller="Assignments" asp-action="Details"
                                   asp-route-id="@ViewBag.AssignmentId"
                                   class="btn btn-outline-secondary">
                                    إلغاء
                                </a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
